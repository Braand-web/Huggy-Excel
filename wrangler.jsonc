{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "huggy-excel",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "routes": [
    { "pattern": "huggy.fun", "custom_domain": true },
    { "pattern": "www.huggy.fun/*", "zone_name": "huggy.fun" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
